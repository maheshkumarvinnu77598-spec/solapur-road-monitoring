rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleFromToken() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        roleFromToken() == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isWorker() {
      return signedIn() && roleFromToken() == 'worker';
    }

    function workerDocId() {
      return isWorker() && request.auth.token.worker_doc_id is string
        ? request.auth.token.worker_doc_id
        : '';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /workers/{workerId} {
      allow read: if signedIn() && (
        isAdmin() ||
        (isWorker() && workerDocId() == workerId)
      );

      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isWorker() &&
        workerDocId() == workerId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'fcm_tokens',
          'last_seen_at',
          'photo_url',
          'phone'
        ])
      );

      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.reporter_id == request.auth.uid;

      allow update: if isAdmin() || (
        signedIn() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'report_count',
