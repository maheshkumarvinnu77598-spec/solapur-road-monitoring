rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isWorkerFor(workerId) {
      return signedIn() &&
        request.auth.token.role == 'worker' &&
        request.auth.token.worker_doc_id == workerId;
    }

    match /reports/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /repairs/{workerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin() || isWorkerFor(workerId);
    }

    match /workers/{workerId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin() || isWorkerFor(workerId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
